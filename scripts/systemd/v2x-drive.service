[Unit]
Description=V2X CARLA Drive Server
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=path
Group=path
SupplementaryGroups=docker
WorkingDirectory=/home/path/v2x-drive
Environment=CARLA_CONTAINER=carla-rr-maps
Environment=CARLA_IMAGE=ghcr.io/simforgeinc/carla-rr-maps:0.10.0
Environment="CARLA_COMMAND=./CarlaUnreal.sh -RenderOffScreen -vulkan -nosound -carla-rpc-port=2000"
Environment=DTB_CARLA_MAP=Richmond_Field_Station_Richmond_CA
Environment=CARLA_PORT=2000
Environment=WS_PORT=8765
Environment=VENV=/home/path/V2XCarla/carla-venv-310/bin/activate
Environment=CARLA_PYTHON=/home/path/V2XCarla/carla-venv-310/bin/python
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/home/path/v2x-drive/scripts/wait-for-carla.sh
ExecStart=/home/path/v2x-drive/scripts/launch-drive.sh
Restart=always
RestartSec=10
TimeoutStartSec=700
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
